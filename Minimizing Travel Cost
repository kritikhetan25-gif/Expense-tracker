class Edge {
    String src, dest;
    int weight;
    Edge(String s, String d, int w) { 
        this.src = s; 
        this.dest = d; 
        this.weight = w; 
    }
}

class Graph {
    Map<String, List<Edge>> adj = new HashMap<>();

    void addCity(String city) { 
        adj.putIfAbsent(city, new ArrayList<>()); 
    }

    void removeCity(String city) {
        adj.remove(city);
        for (List<Edge> list : adj.values()) {
            list.removeIf(e -> e.dest.equals(city));
        }
    }

    void addRoad(String s, String d, int w) {
        if (!adj.containsKey(s) || !adj.containsKey(d)) return;
        adj.get(s).add(new Edge(s, d, w));
        adj.get(d).add(new Edge(d, s, w));
    }

    void removeRoad(String s, String d) {
        if (!adj.containsKey(s) || !adj.containsKey(d)) return;
        adj.get(s).removeIf(e -> e.dest.equals(d));
        adj.get(d).removeIf(e -> e.dest.equals(s));
    }
}


class Dijkstra {
    static Map<String, Integer> shortest(Graph g, String src) {
        Map<String, Integer> dist = new HashMap<>();
        g.adj.keySet().forEach(c -> dist.put(c, Integer.MAX_VALUE));
        PriorityQueue<Edge> pq = new PriorityQueue<>(Comparator.comparingInt(e -> e.weight));
        
        dist.put(src, 0);
        pq.add(new Edge(src, src, 0));

        while (!pq.isEmpty()) {
            Edge curr = pq.poll();
            for (Edge e : g.adj.getOrDefault(curr.dest, new ArrayList<>())) {
                int newDist = dist.get(curr.dest) + e.weight;
                if (newDist < dist.get(e.dest)) {
                    dist.put(e.dest, newDist);
                    pq.add(new Edge(curr.dest, e.dest, newDist));
                }
            }
        }
        return dist;
    }
}


class Traversal {
    static List<String> bfs(Graph g, String start) {
        List<String> res = new ArrayList<>();
        Set<String> vis = new HashSet<>();
        Queue<String> q = new LinkedList<>();
        
        q.add(start); 
        vis.add(start);

        while (!q.isEmpty()) {
            String cur = q.poll();
            res.add(cur);
            for (Edge e : g.adj.getOrDefault(cur, new ArrayList<>())) {
                if (!vis.contains(e.dest)) { 
                    vis.add(e.dest); 
                    q.add(e.dest); 
                }
            }
        }
        return res;
    }
}

class MST {
    static String find(Map<String, String> p, String x) {
        if (!p.get(x).equals(x)) p.put(x, find(p, p.get(x)));
        return p.get(x);
    }

    static List<Edge> kruskal(Graph g) {
        List<Edge> allEdges = new ArrayList<>();
        g.adj.values().forEach(allEdges::addAll);
        allEdges.sort(Comparator.comparingInt(e -> e.weight));

        Map<String, String> parent = new HashMap<>();
        g.adj.keySet().forEach(c -> parent.put(c, c));
        
        List<Edge> result = new ArrayList<>();
        for (Edge e : allEdges) {
            String p1 = find(parent, e.src);
            String p2 = find(parent, e.dest);
            if (!p1.equals(p2)) { 
                result.add(e); 
                parent.put(p1, p2); 
            }
        }
        return result;
    }
}


class ModernGraphPanel extends JPanel {
    Graph graph;
    Map<String, Point> pos = new HashMap<>();
    private final int NODE_SIZE = 46;

    ModernGraphPanel(Graph g) {
        this.graph = g;
        setBackground(new Color(248, 250, 252));
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int n = graph.adj.size();
        if (n == 0) return;

        int cx = getWidth() / 2, cy = getHeight() / 2;
        int r = Math.min(getWidth(), getHeight()) / 3;
        List<String> cities = new ArrayList<>(graph.adj.keySet());

        for (int i = 0; i < n; i++) {
            double angle = 2 * Math.PI * i / n;
            pos.put(cities.get(i), new Point(cx + (int)(r * Math.cos(angle)), cy + (int)(r * Math.sin(angle))));
        }


        g2.setStroke(new BasicStroke(2));
        g2.setColor(new Color(148, 163, 184));
        Set<String> drawn = new HashSet<>();
        for (String c : graph.adj.keySet()) {
            for (Edge e : graph.adj.get(c)) {
                if (drawn.contains(e.dest + "-" + e.src)) continue;
                drawn.add(e.src + "-" + e.dest);
                Point p1 = pos.get(e.src), p2 = pos.get(e.dest);
                g2.draw(new Line2D.Float(p1.x, p1.y, p2.x, p2.y));

                String w = String.valueOf(e.weight);
                int lx = (p1.x + p2.x)/2, ly = (p1.y + p2.y)/2;
                g2.setColor(Color.WHITE);
                g2.fillRect(lx - 10, ly - 12, 20, 15);
                g2.setColor(Color.BLACK);
                g2.drawString(w, lx - 7, ly);
                g2.setColor(new Color(148, 163, 184));
            }
        }

        for (String c : graph.adj.keySet()) {
            Point p = pos.get(c);
            g2.setColor(new Color(37, 99, 235)); // Modern Blue
            g2.fill(new Ellipse2D.Float(p.x - NODE_SIZE/2, p.y - NODE_SIZE/2, NODE_SIZE, NODE_SIZE));
            g2.setColor(Color.WHITE);
            g2.setFont(new Font("SansSerif", Font.BOLD, 12));
            FontMetrics fm = g2.getFontMetrics();
            g2.drawString(c, p.x - fm.stringWidth(c)/2, p.y + 5);
        }
    }
}

public class DAA_Project extends JFrame {
    private Graph graph = new Graph();
    private JTextArea log = new JTextArea(10, 40);
    private ModernGraphPanel canvas = new ModernGraphPanel(graph);
    private JComboBox<String> fromBox = new JComboBox<>(), toBox = new JComboBox<>();

    public DAA_Project() {
        setTitle("TransportNet Designer | DAA Project");
        setSize(1200, 800);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new BorderLayout(10, 10));

        JPanel controls = new JPanel();
        controls.setLayout(new BoxLayout(controls, BoxLayout.Y_AXIS));
        controls.setBorder(new EmptyBorder(20, 20, 20, 20));
        controls.setPreferredSize(new Dimension(320, 0));
        controls.setBackground(Color.WHITE);

        JPanel cityPanel = createTitledPanel("City Management");
        JTextField cityInput = new JTextField();
        JButton btnAddCity = new JButton("Add City");
        JButton btnRemCity = new JButton("Remove City");
        cityPanel.add(new JLabel("City Name:")); cityPanel.add(cityInput);
        cityPanel.add(btnAddCity); cityPanel.add(btnRemCity);

        JPanel roadPanel = createTitledPanel("Road Management");
        JTextField weightInput = new JTextField("10");
        JButton btnAddRoad = new JButton("Add Road");
        roadPanel.add(new JLabel("From:")); roadPanel.add(fromBox);
        roadPanel.add(new JLabel("To:")); roadPanel.add(toBox);
        roadPanel.add(new JLabel("Distance:")); roadPanel.add(weightInput);
        roadPanel.add(btnAddRoad);
        JPanel algoPanel = createTitledPanel("Graph Algorithms");
        JButton btnDijkstra = new JButton("Shortest Path (Dijkstra)");
        JButton btnBFS = new JButton("Connectivity (BFS)");
        JButton btnMST = new JButton("Optimize (Kruskal MST)");
        algoPanel.add(btnDijkstra); algoPanel.add(btnBFS); algoPanel.add(btnMST);

        controls.add(cityPanel); controls.add(Box.createVerticalStrut(15));
        controls.add(roadPanel); controls.add(Box.createVerticalStrut(15));
        controls.add(algoPanel);

        log.setEditable(false);
        log.setBackground(new Color(15, 23, 42)); // Slate Dark
        log.setForeground(new Color(186, 230, 253)); // Light Blue text
        log.setFont(new Font("Monospaced", Font.PLAIN, 13));
        log.setMargin(new Insets(10, 10, 10, 10));
        JScrollPane scroll = new JScrollPane(log);
        scroll.setBorder(new TitledBorder("Process Log"));

        add(controls, BorderLayout.WEST);
        add(canvas, BorderLayout.CENTER);
        add(scroll, BorderLayout.SOUTH);

        btnAddCity.addActionListener(e -> {
            String c = cityInput.getText().trim();
            if (!c.isEmpty()) {
                graph.addCity(c); 
                fromBox.addItem(c); 
                toBox.addItem(c);
                log.append("[SYSTEM] City Registered: " + c + "\n");
                cityInput.setText(""); 
                canvas.repaint();
            }
        });

        btnRemCity.addActionListener(e -> {
            String c = cityInput.getText().trim();
            graph.removeCity(c);
            fromBox.removeItem(c);
            toBox.removeItem(c);
            log.append("[SYSTEM] City Removed: " + c + "\n");
            canvas.repaint();
        });

        btnAddRoad.addActionListener(e -> {
            try {
                String f = (String)fromBox.getSelectedItem(), t = (String)toBox.getSelectedItem();
                int w = Integer.parseInt(weightInput.getText());
                if (f != null && t != null && !f.equals(t)) {
                    graph.addRoad(f, t, w);
                    log.append("[NETWORK] Road built: " + f + " <-> " + t + " (" + w + ")\n");
                    canvas.repaint();
                }
            } catch (Exception ex) { JOptionPane.showMessageDialog(this, "Enter valid distance!"); }
        });

        btnDijkstra.addActionListener(e -> {
            String s = (String)fromBox.getSelectedItem();
            if (s != null) {
                Map<String, Integer> res = Dijkstra.shortest(graph, s);
                log.append("[DIJKSTRA] Analysis from " + s + ":\n");
                res.forEach((city, dist) -> log.append(" -> " + city + ": " + (dist == Integer.MAX_VALUE ? "Unreachable" : dist + " km") + "\n"));
            }
        });

        btnBFS.addActionListener(e -> {
            String s = (String)fromBox.getSelectedItem();
            if (s != null) {
                List<String> order = Traversal.bfs(graph, s);
                log.append("[BFS] Traversal Order: " + order + "\n");
                log.append(order.size() == graph.adj.size() ? " > Status: Fully Connected\n" : " > Status: Disconnected Components Detected\n");
            }
        });

        btnMST.addActionListener(e -> {
            List<Edge> m = MST.kruskal(graph);
            int total = m.stream().mapToInt(ed -> ed.weight).sum();
            log.append("[KRUSKAL MST] Optimized Network Edges:\n");
            for(Edge ed : m) log.append(" + " + ed.src + " - " + ed.dest + " (" + ed.weight + ")\n");
            log.append(" > Minimum Construction Cost: " + total + "\n");
        });

        setLocationRelativeTo(null);
        setVisible(true);
    }

    private JPanel createTitledPanel(String title) {
        JPanel p = new JPanel(new GridLayout(0, 1, 5, 5));
        p.setBorder(BorderFactory.createTitledBorder(BorderFactory.createEtchedBorder(), title));
        p.setBackground(Color.WHITE);
        return p;
    }

    public static void main(String[] args) {
        // Use system look and feel
        try { UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName()); } catch (Exception ignored) {}
        SwingUtilities.invokeLater(DAA_Project::new);
    }
}









